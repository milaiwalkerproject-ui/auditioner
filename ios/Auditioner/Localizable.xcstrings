    "The reference audio at your tempo and tuning, without the count-in. Share it, or save it to Files." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Referenzaudio in deinem Tempo und deiner Stimmung, ohne Einzähler. Teile es oder sichere es in „Dateien“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El audio de referencia a tu tempo y afinación, sin la cuenta de entrada. Compártelo o guárdalo en Archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'audio de référence à votre tempo et à votre diapason, sans le décompte. Partagez-le, ou exportez-le vers Fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'audio di riferimento al tuo tempo e alla tua intonazione, senza il conteggio. Condividilo o salvalo in File."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定したテンポとチューニングの参考音源です（カウントインなし）。共有するか、「ファイル」に保存できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 템포와 튜닝으로 만든 레퍼런스 오디오예요. 예비박은 들어가지 않아요. 공유하거나 파일 앱에 저장하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O áudio de referência no seu andamento e afinação, sem a contagem de entrada. Compartilhe ou salve no app Arquivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аудиообразец в вашем темпе и строе, без отсчёта. Поделитесь им или сохраните в Файлы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按你的速度和标准音生成的参考音频，不含预备拍。可以共享，或存储到“文件”。"
          }
