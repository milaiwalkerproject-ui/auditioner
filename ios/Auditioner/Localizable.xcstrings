          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카탈로그, 발췌곡 페이지, 녹음, 내 파트보 등 앱의 나머지 기능은 아무것도 보내지 않고 작동해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O resto do app — o catálogo, as páginas de excerto, as gravações e suas partes — funciona sem enviar nada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё остальное в приложении — каталог, страницы фрагментов, записи и ваши партии — работает, ничего не отправляя."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 的其他部分——曲库、片段页面、录音和你的分谱——无需发送任何内容即可使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 的其他部分（曲庫、片段頁面、錄音和你的分譜）不需要傳送任何資料就能使用。"
          }
        }
      }
    },
