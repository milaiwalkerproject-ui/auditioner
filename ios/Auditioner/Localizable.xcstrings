        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altre %lld liste non dicono per quale ruolo erano. Attiva Includi tutti i ruoli per contarle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかに%lld件のリストにはポジションの記載がありません。「すべてのポジションを含める」をオンにすると集計に含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "리스트 %lld개는 어느 포지션용인지 적혀 있지 않아요. 집계에 넣으려면 모든 포지션 포함을 켜세요."
          }
        },
        "pt-BR" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Mais %lld lista não diz para qual posição era. Ative Incluir todas as posições para contá-la."
                }
