    "Used to pick which excerpts you see first. Nothing here leaves the device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestimmt, welche Stellen du zuerst siehst. Nichts davon verlässt das Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para decidir qué extractos ves primero. Nada de esto sale del dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sert à choisir les traits que vous voyez en premier. Rien ici ne quitte l'appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve a scegliere quali passi vedi per primi. Niente di questo lascia il dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初に表示するオケスタを選ぶために使われます。ここの情報がデバイスの外に出ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떤 발췌곡을 먼저 보여줄지 정하는 데 쓰여요. 이 정보는 기기 밖으로 나가지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado para escolher quais excertos você vê primeiro. Nada daqui sai do dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется, чтобы выбрать, какие фрагменты показывать первыми. Ничего из этого не покидает устройство."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于决定优先显示哪些片段。这里的信息不会离开设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用來決定你優先看到哪些片段。這裡的資料不會離開裝置。"
          }
        }
      }
