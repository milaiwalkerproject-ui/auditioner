    "Your own numbers. The catalogue's typical tempo, when it is verified, is shown above." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine eigenen Zahlen. Das übliche Tempo aus dem Katalog steht oben, wenn es geprüft ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus propias cifras. El tempo habitual del catálogo, cuando está verificado, se muestra arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos propres chiffres. Le tempo habituel du catalogue, lorsqu'il est vérifié, est affiché au-dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi numeri. Il tempo abituale del catalogo, quando è verificato, è mostrato qui sopra."
