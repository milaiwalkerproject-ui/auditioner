    "Scan or import your part and get reference audio you can slow down and loop." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne oder importiere deine Noten und erhalte Referenzaudio, das du verlangsamen und loopen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea o importa tu parte y obtén un audio de referencia que puedes ralentizar y repetir en bucle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
