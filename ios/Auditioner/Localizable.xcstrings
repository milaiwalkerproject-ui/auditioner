    "Drag the box around the bars you want. Drag a corner to resize it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh den Rahmen um die Takte, die du brauchst. Zieh an einer Ecke, um die Größe zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra el recuadro hasta rodear los compases que quieras. Arrastra una esquina para cambiar su tamaño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacez le cadre autour des mesures voulues. Faites glisser un coin pour le redimensionner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina il riquadro attorno alle battute che vuoi. Trascina un angolo per ridimensionarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要な小節を囲むように枠をドラッグします。角をドラッグするとサイズを変えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원하는 마디를 상자로 둘러싸세요. 모서리를 끌면 크기를 바꿀 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste a caixa até os compassos que você quer. Arraste um canto para redimensionar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите рамку на нужные такты. Потяните за угол, чтобы изменить её размер."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动方框框住你需要的小节。拖动角落可调整大小。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖曳方框圈住你要的小節。拖曳角落可調整大小。"
          }
        }
      }
    },
