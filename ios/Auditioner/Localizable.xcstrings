    "Each excerpt page lists every source we counted for it, with a link to the orchestra's own page." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Seite zur Stelle nennt alle Quellen, die wir dafür gezählt haben, mit Link zur eigenen Seite des Orchesters."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada página de extracto enumera todas las fuentes que contamos para él, con un enlace a la página de la propia orquesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque page de trait répertorie toutes les sources comptées pour ce trait, avec un lien vers la page de l'orchestre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni pagina del passo elenca tutte le fonti che abbiamo contato, con un link alla pagina dell'orchestra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各オケスタのページには、集計に使ったすべての出典を、オーケストラ自身のページへのリンクとともに載せています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 발췌곡 페이지에는 집계에 쓴 모든 출처가 오케스트라 공식 페이지 링크와 함께 나와요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada página de excerto lista todas as fontes que contamos para ele, com um link para a página da própria orquestra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На странице каждого фрагмента перечислены все источники, которые мы учли, со ссылкой на страницу самого оркестра."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个片段页面都列出了我们为其统计的全部来源，并附有乐团官网页面的链接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個片段頁面都列出我們計入的所有來源，並附上樂團官方頁面的連結。"
          }
        }
      }
    },
