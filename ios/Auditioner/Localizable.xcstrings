    "%lld more lists don't say which chair they were for. Turn on Include all chairs to count them." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld weitere Liste sagt nicht, für welche Position sie galt. Schalte „Alle Positionen einbeziehen“ ein, um sie mitzuzählen."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld weitere Listen sagen nicht, für welche Position sie galten. Schalte „Alle Positionen einbeziehen“ ein, um sie mitzuzählen."
