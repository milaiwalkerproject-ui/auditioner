    "Auditioner needs permission to use Apple Music. You can allow it in the Settings app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditioner braucht die Erlaubnis, Apple Music zu nutzen. Du kannst sie in der App „Einstellungen“ erteilen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditioner necesita permiso para usar Apple Music. Puedes permitirlo en la app Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditioner a besoin de l'autorisation d'utiliser Apple Music. Vous pouvez l'accorder dans l'app Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditioner ha bisogno del permesso per usare Apple Music. Puoi concederlo nell'app Impostazioni."
          }
