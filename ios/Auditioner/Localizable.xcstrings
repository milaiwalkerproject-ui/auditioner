    "Bar %@ has no notes in the top voice. Tap a note in a bar next to it and use Insert." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takt %@ hat in der obersten Stimme keine Noten. Tippe auf eine Note in einem Takt daneben und benutze „Einfügen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El compás %@ no tiene notas en la voz superior. Toca una nota de un compás contiguo y usa Insertar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mesure %@ n'a aucune note dans la voix supérieure. Touchez une note d'une mesure voisine et utilisez Insérer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La battuta %@ non ha note nella voce superiore. Tocca una nota in una battuta vicina e usa Inserisci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第%@小節の上声部に音符がありません。隣の小節の音符をタップして「挿入」を使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@마디의 윗성부에 음표가 없어요. 옆 마디의 음표를 누른 뒤 삽입을 사용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O compasso %@ não tem notas na voz superior. Toque em uma nota de um compasso vizinho e use Inserir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В такте %@ нет нот в верхнем голосе. Коснитесь ноты в соседнем такте и нажмите «Вставить»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第 %@ 小节的最上方声部没有音符。请点按相邻小节中的一个音符，然后使用“插入”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第 %@ 小節的最上方聲部沒有音符。請點一下相鄰小節中的音符，再使用「插入」。"
          }
        }
      }
    },
