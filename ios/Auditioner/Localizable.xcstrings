    "Add a PDF from Files (including iCloud Drive, Google Drive and Dropbox), a photo from Photos, or scan a page with the camera. Your parts stay on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge ein PDF aus „Dateien“ (auch iCloud Drive, Google Drive und Dropbox) oder ein Foto aus „Fotos“ hinzu, oder scanne eine Seite mit der Kamera. Deine Noten bleiben auf diesem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un PDF desde Archivos (incluidos iCloud Drive, Google Drive y Dropbox), una foto desde Fotos, o escanea una página con la cámara. Tus partes se quedan en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un PDF depuis Fichiers (y compris iCloud Drive, Google Drive et Dropbox), une photo depuis Photos, ou scannez une page avec l'appareil photo. Vos partitions restent sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi un PDF da File (anche iCloud Drive, Google Drive e Dropbox), una foto da Foto, oppure scansiona una pagina con la fotocamera. Le tue parti restano su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ファイル」（iCloud Drive、Google Drive、Dropboxを含む）からPDFを、「写真」から写真を追加するか、カメラでページをスキャンします。パート譜がこのデバイスの外に出ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일 앱(iCloud Drive, Google Drive, Dropbox 포함)에서 PDF를, 사진 앱에서 사진을 추가하거나 카메라로 페이지를 스캔하세요. 파트보는 이 기기에만 저장돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione um PDF do app Arquivos (inclusive iCloud Drive, Google Drive e Dropbox), uma foto do app Fotos, ou escaneie uma página com a câmera. Suas partes ficam neste dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте PDF из Файлов (включая iCloud Drive, Google Drive и Dropbox), фото из Фото или отсканируйте страницу камерой. Ваши партии остаются на этом устройстве."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从“文件”（包括 iCloud 云盘、Google Drive 和 Dropbox）添加 PDF，从“照片”添加照片，或用相机扫描一页。你的分谱只保存在这台设备上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從「檔案」加入 PDF（包括 iCloud 雲碟、Google 雲端硬碟和 Dropbox）、從「照片」加入照片，或用相機掃描一頁。你的分譜只會留在這部裝置上。"
          }
        }
      }
    },
