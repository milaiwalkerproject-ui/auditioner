        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스캔, 파트보, 녹음은 어떤 AI 서비스에도 절대 보내지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
