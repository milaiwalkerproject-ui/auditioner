    "Your scans, parts and recordings are never sent to any AI service." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Scans, Noten und Aufnahmen gehen nie an einen KI-Dienst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus escaneos, partes y grabaciones nunca se envían a ningún servicio de IA."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos scans, partitions et enregistrements ne sont jamais envoyés à un service d'IA."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue scansioni, parti e registrazioni non vengono mai inviate a nessun servizio di IA."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキャン、パート譜、録音がAIサービスに送られることはありません。"
