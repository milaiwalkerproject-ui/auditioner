    "1 more list doesn't say which chair it was for. Turn on Include all chairs to count it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 weitere Liste sagt nicht, für welche Position sie galt. Schalte „Alle Positionen einbeziehen“ ein, um sie mitzuzählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 lista más no dice para qué posición era. Activa Incluir todas las posiciones para contarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 liste de plus ne précise pas le poste visé. Activez Inclure tous les postes pour la compter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un'altra lista non dice per quale ruolo era. Attiva Includi tutti i ruoli per contarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかに1件のリストにはポジションの記載がありません。「すべてのポジションを含める」をオンにすると集計に含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "리스트 1개는 어느 포지션용인지 적혀 있지 않아요. 집계에 넣으려면 모든 포지션 포함을 켜세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais 1 lista não diz para qual posição era. Ative Incluir todas as posições para contá-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ещё 1 список не указывает позицию. Включите «Учитывать все позиции», чтобы учесть его."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另有 1 份曲目单未注明席位。打开“包含所有席位”即可将它计入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另有 1 份清單未註明職位。開啟「包含所有職位」即可計入。"
          }
        }
      }
    },
    "1 not started · 3 under tempo · 5 audition-ready. Tap the same star again to clear." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 nicht angefangen · 3 unter Tempo · 5 probespielreif. Tippe noch einmal auf denselben Stern, um die Bewertung zu löschen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 sin empezar · 3 por debajo del tempo · 5 listo para la audición. Toca la misma estrella otra vez para borrar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 pas commencé · 3 sous le tempo · 5 prêt pour l'audition. Touchez à nouveau la même étoile pour effacer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 non iniziato · 3 sotto tempo · 5 pronto per l'audizione. Tocca di nuovo la stessa stella per azzerare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 = 未着手 · 3 = テンポ未達 · 5 = 本番OK。同じ星をもう一度タップすると解除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1은 시작 전 · 3은 템포 미달 · 5는 오디션 준비 완료. 같은 별을 다시 누르면 지워져요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 não iniciado · 3 abaixo do andamento · 5 pronto para a audição. Toque na mesma estrela de novo para limpar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 — не начато · 3 — ниже темпа · 5 — готово к прослушиванию. Коснитесь той же звезды ещё раз, чтобы сбросить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 星：尚未开始 · 3 星：未达速度 · 5 星：可以上场。再次点按同一颗星即可清除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 顆星：尚未開始 · 3 顆星：速度未達 · 5 顆星：可上場。再點一次同一顆星即可清除。"
          }
        }
      }
    },
    "1 of these lists has no date and counts as the oldest year we have (%@)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 dieser Listen hat kein Datum und zählt wie das älteste Jahr, das wir haben (%@)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 de estas listas no tiene fecha y cuenta como el año más antiguo que tenemos (%@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 de ces listes n'a pas de date et compte comme l'année la plus ancienne que nous ayons (%@)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 di queste liste non ha data e conta come l'anno più vecchio che abbiamo (%@)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このうち1件のリストには日付がなく、手元で最も古い年（%@）として数えています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 중 리스트 1개는 날짜가 없어서 가장 오래된 연도(%@)로 계산해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 destas listas não tem data e conta como o ano mais antigo que temos (%@)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 из этих списков без даты; он учитывается как самый ранний имеющийся год (%@)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其中 1 份曲目单没有日期，按我们已有的最早年份（%@）计算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其中 1 份清單沒有日期，以我們現有最早的年份（%@）計算。"
          }
        }
      }
    },
