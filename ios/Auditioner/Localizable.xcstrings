    "Open the excerpt page: tempo, techniques to watch, history, pitfalls and recordings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne die Seite zur Stelle: Tempo, Techniken, auf die es ankommt, Geschichte, Stolperfallen und Aufnahmen."
          }
