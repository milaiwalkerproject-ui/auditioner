    "Nothing in the %@ catalogue matches. Try just the composer's surname, or leave the line unlinked." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Katalog für %@ passt nichts. Versuch nur den Nachnamen des Komponisten oder lass die Zeile unverknüpft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada del catálogo de %@ coincide. Prueba solo con el apellido del compositor o deja la línea sin vincular."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien ne correspond dans le catalogue « %@ ». Essayez seulement le nom du compositeur, ou laissez la ligne sans lien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna corrispondenza nel catalogo per %@. Prova solo con il cognome del compositore, oppure lascia la riga non collegata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のカタログに一致するものがありません。作曲者の姓だけで試すか、リンクせずに残してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 카탈로그에 일치하는 항목이 없어요. 작곡가 성만 입력해 보거나, 줄을 연결하지 않은 채 두세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada no catálogo de %@ corresponde. Tente só o sobrenome do compositor ou deixe a linha sem vínculo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В каталоге (%@) ничего не найдено. Попробуйте только фамилию композитора или оставьте строку без привязки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@曲库中没有匹配项。试试只输入作曲家的姓氏，或让这一行保持未关联。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@曲庫中沒有相符的項目。試試只輸入作曲家的姓氏，或讓這一行保持未連結。"
          }
        }
      }
    },
    "Nothing recorded yet. Use Record in the practice player, or record a mock audition." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nichts aufgenommen. Benutze „Aufnehmen“ im Übe-Player oder nimm eine Probespiel-Simulation auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
