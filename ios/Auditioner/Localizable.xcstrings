    "Optional. Gives you more scans a day." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Gibt dir mehr Scans pro Tag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Te da más escaneos al día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif. Vous donne plus de scans par jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facoltativo. Ti dà più scansioni al giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意です。1日のスキャン回数が増えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택 사항. 하루 스캔 횟수가 늘어나요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Dá mais escaneamentos por dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необязательно. Даёт больше сканов в день."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可选。可提高每日扫描次数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選用。可增加每日掃描次數。"
          }
        }
      }
    },
    "Optional. Signing in gives you more scans a day. Everything else works without an account. Accounts need the server, which isn't set up yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Mit Anmeldung hast du mehr Scans pro Tag. Alles andere funktioniert ohne Account. Accounts brauchen den Server, der noch nicht eingerichtet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Iniciar sesión te da más escaneos al día. Todo lo demás funciona sin cuenta. Las cuentas necesitan el servidor, que aún no está configurado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif. Se connecter vous donne plus de scans par jour. Tout le reste fonctionne sans compte. Les comptes nécessitent le serveur, qui n'est pas encore configuré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facoltativo. Accedendo hai più scansioni al giorno. Tutto il resto funziona senza account. Gli account richiedono il server, che non è ancora configurato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意です。サインインすると1日のスキャン回数が増えます。それ以外はアカウントなしで使えます。アカウントにはサーバが必要ですが、まだ設定されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택 사항. 로그인하면 하루 스캔 횟수가 늘어나요. 그 외 모든 기능은 계정 없이 쓸 수 있어요. 계정을 쓰려면 서버가 필요한데, 아직 설정되지 않았어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Iniciar sessão dá mais escaneamentos por dia. Todo o resto funciona sem conta. As contas precisam do servidor, que ainda não foi configurado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необязательно. Вход даёт больше сканов в день. Всё остальное работает без аккаунта. Для аккаунта нужен сервер, а он ещё не настроен."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可选。登录后每天可扫描更多次。其他所有功能无需账户即可使用。账户需要服务器，但服务器尚未设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選用。登入後每天可掃描更多次。其他功能不需要帳號也能使用。帳號功能需要伺服器，但伺服器尚未設定。"
          }
        }
      }
    },
    "Optional. Signing in gives you more scans a day. Everything else works without an account. We don't ask Apple for your name or email." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Mit Anmeldung hast du mehr Scans pro Tag. Alles andere funktioniert ohne Account. Wir fragen Apple nicht nach deinem Namen oder deiner E-Mail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Iniciar sesión te da más escaneos al día. Todo lo demás funciona sin cuenta. No le pedimos a Apple tu nombre ni tu correo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif. Se connecter vous donne plus de scans par jour. Tout le reste fonctionne sans compte. Nous ne demandons à Apple ni votre nom ni votre e-mail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facoltativo. Accedendo hai più scansioni al giorno. Tutto il resto funziona senza account. Non chiediamo ad Apple il tuo nome né la tua email."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意です。サインインすると1日のスキャン回数が増えます。それ以外はアカウントなしで使えます。Appleに名前やメールアドレスを求めることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택 사항. 로그인하면 하루 스캔 횟수가 늘어나요. 그 외 모든 기능은 계정 없이 쓸 수 있어요. Apple에 이름이나 이메일을 요청하지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Iniciar sessão dá mais escaneamentos por dia. Todo o resto funciona sem conta. Não pedimos à Apple seu nome nem seu e-mail."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необязательно. Вход даёт больше сканов в день. Всё остальное работает без аккаунта. Мы не запрашиваем у Apple ваше имя и e-mail."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可选。登录后每天可扫描更多次。其他所有功能无需账户即可使用。我们不会向 Apple 索取你的姓名或电子邮件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選用。登入後每天可掃描更多次。其他功能不需要帳號也能使用。我們不會向 Apple 索取你的姓名或電子郵件。"
          }
        }
      }
    },
