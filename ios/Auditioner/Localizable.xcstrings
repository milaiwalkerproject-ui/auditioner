    "Lowest readiness first, then the earliest round, then the harder excerpt." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geringster Fortschritt zuerst, dann die frühere Runde, dann die schwerere Stelle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero la preparación más baja, luego la ronda más temprana y luego el extracto más difícil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le moins préparé d'abord, puis le tour le plus proche, puis le trait le plus difficile."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima i meno pronti, poi il turno più vicino, poi il passo più difficile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "準備状況が低い順、次に早い審査段階、次に難しいオケスタの順です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "준비가 덜 된 것부터, 그다음 빠른 라운드, 그다음 어려운 발췌곡 순이에요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primeiro o menor preparo, depois a fase mais próxima, depois o excerto mais difícil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала самая низкая готовность, затем более ранний тур, затем более сложный фрагмент."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "准备程度最低的在前，然后按最早的轮次，再按较难的片段。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "準備度最低的優先，其次是最早的輪次，再來是較難的片段。"
          }
        }
      }
    },
