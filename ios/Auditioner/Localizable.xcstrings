    "From players who share what they practise — not what orchestras ask." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von denen, die teilen, was sie üben – nicht, was Orchester verlangen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De músicos que comparten lo que practican, no de lo que piden las orquestas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D'après les musiciens qui partagent ce qu'ils travaillent — pas ce que les orchestres demandent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da musicisti che condividono cosa studiano — non da ciò che chiedono le orchestre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "練習内容を共有している奏者のデータであり、オーケストラの課題ではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연습 내용을 공유하는 연주자들의 데이터예요 — 오케스트라가 요구하는 곡이 아니에요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De músicos que compartilham o que estudam — não do que as orquestras pedem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По данным музыкантов, которые делятся тем, что репетируют, — а не по запросам оркестров."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自共享练习内容的演奏者——而非乐团的要求。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "來自分享練習內容的演奏者，而非樂團的要求。"
          }
        }
      }
    },
