        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "직접 적는 숫자예요. 카탈로그의 일반적인 템포는 확인된 경우 위에 표시돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus próprios números. O andamento típico do catálogo, quando verificado, aparece acima."
