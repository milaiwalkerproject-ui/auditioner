          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записей пока нет. Нажмите «Записать» в плеере для занятий или запишите пробное прослушивание."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
