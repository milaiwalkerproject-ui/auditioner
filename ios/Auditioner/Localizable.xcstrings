    "Fewer than %lld %@ from %@ so far, so this counts lists from every region." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus %3$@ gibt es bisher weniger als %1$lld Listen %2$@, deshalb zählen hier Listen aus allen Regionen."
          }
        },
        "es" : {
          "stringUnit" : {
