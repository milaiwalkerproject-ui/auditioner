    "Paste the list, one line per work. Headings like “Preliminary round” or “Solo” are understood." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge die Liste ein, eine Zeile pro Werk. Überschriften wie „Vorrunde“ oder „Solo“ werden erkannt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pega la lista, una línea por obra. Se entienden encabezados como «Ronda preliminar» o «Solo»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collez la liste, une ligne par œuvre. Les titres comme « Tour préliminaire » ou « Solo » sont compris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incolla la lista, una riga per brano. Intestazioni come “Turno preliminare” o “Solo” vengono riconosciute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リストを1作品1行で貼り付けてください。「一次審査」や「ソロ」などの見出しも認識されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작품마다 한 줄씩 리스트를 붙여 넣으세요. “예선”이나 “솔로” 같은 제목도 인식해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cole a lista, uma linha por obra. Títulos como “Fase preliminar” ou “Solo” são reconhecidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вставьте список, по одной строке на произведение. Заголовки вроде «Отборочный тур» или «Соло» распознаются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粘贴曲目单，每部作品一行。可识别“Preliminary round”或“Solo”之类的标题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貼上清單，每個作品一行。「初試」、「獨奏」之類的標題也能辨識。"
          }
        }
      }
    },
