    "Our server has no reviewed lists for this chair yet, so this uses the lists in the app's catalogue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unser Server hat für diese Position noch keine geprüften Listen, deshalb werden hier die Listen aus dem Katalog der App verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuestro servidor aún no tiene listas revisadas para esta posición, así que esto usa las listas del catálogo de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notre serveur n'a pas encore de listes relues pour ce poste : les listes du catalogue de l'app sont utilisées à la place."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nostro server non ha ancora liste revisionate per questo ruolo, quindi qui si usano le liste del catalogo dell'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このポジションのレビュー済みリストがサーバにまだないため、アプリのカタログにあるリストを使っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버에 이 포지션의 검수된 리스트가 아직 없어서 앱 카탈로그의 리스트를 사용해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nosso servidor ainda não tem listas revisadas para esta posição, então isto usa as listas do catálogo do app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На нашем сервере пока нет проверенных списков для этой позиции, поэтому используются списки из каталога приложения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
