    "Archive audition on an audition's page moves it here. You can restore it any time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Probespiel archivieren“ auf der Seite eines Probespiels verschiebt es hierher. Du kannst es jederzeit wiederherstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivar audición, en la página de una audición, la mueve aquí. Puedes restaurarla en cualquier momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Archiver l'audition » sur la page d'une audition la déplace ici. Vous pouvez la restaurer à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivia audizione, nella pagina di un'audizione, la sposta qui. Puoi ripristinarla in qualsiasi momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーディションのページで「オーディションをアーカイブ」を選ぶと、ここに移動します。いつでも復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오디션 페이지에서 오디션 보관을 누르면 여기로 이동해요. 언제든지 복원할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivar audição, na página de uma audição, move essa audição para cá. Você pode restaurá-la a qualquer momento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Архивировать прослушивание» на странице прослушивания переносит его сюда. Его можно восстановить в любой момент."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在试奏页面上点按“归档试奏”，它就会移到这里。你可以随时恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在甄選頁面點選「封存甄選」，就會移到這裡。你可以隨時復原。"
          }
        }
      }
    },
