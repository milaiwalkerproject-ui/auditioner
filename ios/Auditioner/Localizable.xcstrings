    "Only a web address is kept. The orchestra's file itself is never stored by the app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeichert wird nur eine Webadresse. Die Datei des Orchesters selbst speichert die App nie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se guarda una dirección web. La app nunca almacena el archivo de la orquesta."
          }
        },
        "fr" : {
          "stringUnit" : {
