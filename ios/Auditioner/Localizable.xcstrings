        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AuditionerがApple Musicを使うには許可が必要です。「設定」アプリで許可できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditioner가 Apple Music을 사용하려면 권한이 필요해요. 설정 앱에서 허용할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
