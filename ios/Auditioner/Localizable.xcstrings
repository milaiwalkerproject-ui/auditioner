    "%lld of these lists have no date and count as the oldest year we have (%@)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld dieser Listen haben kein Datum und zählen wie das älteste Jahr, das wir haben (%@)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld de estas listas no tienen fecha y cuentan como el año más antiguo que tenemos (%@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld de ces listes n'ont pas de date et comptent comme l'année la plus ancienne que nous ayons (%@)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld di queste liste non hanno data e contano come l'anno più vecchio che abbiamo (%@)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このうち%1$lld件のリストには日付がなく、手元で最も古い年（%2$@）として数えています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 중 리스트 %lld개는 날짜가 없어서 가장 오래된 연도(%@)로 계산해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld destas listas não têm data e contam como o ano mais antigo que temos (%@)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld из этих списков без даты; они учитываются как самый ранний имеющийся год (%@)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其中 %lld 份曲目单没有日期，按我们已有的最早年份（%@）计算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其中 %lld 份清單沒有日期，以我們現有最早的年份（%@）計算。"
          }
        }
      }
