    "Lists from your region come first. When we have fewer than %lld from there, we say so and count every region." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listen aus deiner Region kommen zuerst. Wenn wir von dort weniger als %lld haben, sagen wir das und zählen alle Regionen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las listas de tu región van primero. Cuando tenemos menos de %lld de allí, lo decimos y contamos todas las regiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les listes de votre région passent en premier. Quand nous en avons moins de %lld, nous le disons et comptons toutes les régions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le liste della tua regione vengono prima. Quando ne abbiamo meno di %lld, lo diciamo e contiamo tutte le regioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まずあなたの地域のリストを使います。その地域のリストが%lld件未満の場合はその旨を表示し、すべての地域を集計します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 지역의 리스트를 먼저 봐요. 그 지역 리스트가 %lld개 미만이면 그렇다고 알려 드리고 모든 지역을 집계해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As listas da sua região vêm primeiro. Quando temos menos de %lld de lá, avisamos e contamos todas as regiões."
          }
        },
        "ru" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Сначала учитываются списки из вашего региона. Если их меньше %lld, мы сообщаем об этом и учитываем все регионы."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Сначала учитываются списки из вашего региона. Если их меньше %lld, мы сообщаем об этом и учитываем все регионы."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Сначала учитываются списки из вашего региона. Если их меньше %lld, мы сообщаем об этом и учитываем все регионы."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Сначала учитываются списки из вашего региона. Если их меньше %lld, мы сообщаем об этом и учитываем все регионы."
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "优先统计你所在地区的曲目单。当该地区不足 %lld 份时，我们会说明，并统计所有地区。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "優先計入你所在地區的清單。若該地區不到 %lld 份，我們會說明，並改為計入所有地區。"
          }
        }
      }
    },
