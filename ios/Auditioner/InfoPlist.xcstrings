    "NSAppleMusicUsageDescription" : {
      "comment" : "Permission prompt (Apple Music). Keep the exact meaning: the app only plays recordings from the start of an excerpt when the player has a subscription.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditioner spielt Aufnahmen aus Apple Music ab dem Anfang einer Stelle ab, wenn du ein Abonnement hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditioner plays Apple Music recordings from the start of an excerpt when you have a subscription."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditioner reproduce grabaciones de Apple Music desde el inicio de un extracto cuando tienes una suscripción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditioner lit les enregistrements Apple Music à partir du début d'un trait lorsque vous avez un abonnement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditioner riproduce le registrazioni di Apple Music dall'inizio di un passo quando hai un abbonamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditionerは、サブスクリプションがある場合にApple Musicの録音をオケスタの開始位置から再生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditioner는 구독 중일 때 Apple Music 녹음을 발췌곡 시작 지점부터 재생합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Auditioner reproduz gravações do Apple Music a partir do início de um excerto quando você tem uma assinatura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditioner воспроизводит записи из Apple Music с начала фрагмента, если у вас есть подписка."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你有 Apple Music 订阅时，Auditioner 会从片段开头播放 Apple Music 录音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當你有 Apple Music 訂閱時，Auditioner 會從片段開頭播放 Apple Music 錄音。"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Permission prompt (camera). Shown the first time the player scans a part.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditioner verwendet die Kamera, um deine Noten zu scannen, die Stelle zu erkennen und Referenzaudio zu erstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditioner uses the camera to scan your part so it can recognise the excerpt and make reference audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditioner usa la cámara para escanear tu parte y así reconocer el extracto y crear audio de referencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditioner utilise l'appareil photo pour scanner votre partition afin de reconnaître le trait et de créer l'audio de référence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditioner usa la fotocamera per scansionare la tua parte, così da riconoscere il passo e creare l'audio di riferimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditionerはパート譜をスキャンしてオケスタを認識し、参考音源を作成するためにカメラを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditioner는 카메라로 파트보를 스캔하여 발췌곡을 인식하고 레퍼런스 오디오를 만듭니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Auditioner usa a câmera para escanear sua parte, reconhecer o excerto e criar o áudio de referência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditioner использует камеру, чтобы сканировать вашу партию, распознавать фрагмент и создавать аудиообразец."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditioner 使用相机扫描你的分谱，以识别片段并生成参考音频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditioner 使用相機掃描你的分譜，以辨識片段並製作參考音訊。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Permission prompt (microphone). Shown the first time the player records a take.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditioner nimmt dein Üben auf, damit du es mit der Referenz vergleichen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditioner records your practice so you can compare it with the reference."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditioner graba tu práctica para que puedas compararla con la referencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditioner enregistre votre travail pour que vous puissiez le comparer à la référence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditioner registra il tuo studio, così puoi confrontarlo con il riferimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditionerは、参考音源と比較できるように練習を録音します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditioner는 연습을 녹음하여 레퍼런스와 비교할 수 있게 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Auditioner grava seu estudo para que você possa compará-lo com a referência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditioner записывает ваши занятия, чтобы вы могли сравнить их с образцом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditioner 会录下你的练习，以便你与参考音频进行对比。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auditioner 會錄下你的練習，讓你能與參考音訊比較。"
          }
        }
      }
    },
