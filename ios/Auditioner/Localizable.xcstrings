    "Leave a date off if the orchestra hasn't announced it. Reminders use these dates." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass ein Datum weg, wenn das Orchester es noch nicht bekannt gegeben hat. Erinnerungen richten sich nach diesen Terminen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja una fecha sin poner si la orquesta no la ha anunciado. Los recordatorios usan estas fechas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez une date vide si l'orchestre ne l'a pas annoncée. Les rappels utilisent ces dates."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia vuota una data se l'orchestra non l'ha annunciata. I promemoria usano queste date."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーケストラが発表していない日付は空欄のままにしてください。通知はこれらの日付をもとに届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오케스트라가 아직 발표하지 않은 날짜는 비워 두세요. 알림은 이 날짜를 기준으로 해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe a data em branco se a orquestra ainda não a anunciou. Os lembretes usam estas datas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не указывайте дату, если оркестр её не объявил. Напоминания используют эти даты."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果乐团尚未公布日期，请留空。提醒会使用这些日期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果樂團尚未公布日期，可以先留空。提醒會依這些日期發送。"
          }
        }
      }
    },
