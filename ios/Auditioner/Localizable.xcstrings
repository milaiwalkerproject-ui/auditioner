    "We haven't collected any %@ yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben noch keine Listen %@ gesammelt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hemos recopilado %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous n'avons encore collecté aucune liste %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non abbiamo ancora raccolto liste %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はまだ収集していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 %@를 하나도 모으지 못했어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não coletamos listas %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У нас пока нет %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们还没有收集到任何%@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們還沒有收集到任何%@。"
          }
        }
      }
    },
    "We haven't collected any lists for your chair yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben noch keine Listen für deine Position gesammelt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hemos recopilado listas para tu posición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous n'avons encore collecté aucune liste pour votre poste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non abbiamo ancora raccolto liste per il tuo ruolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのポジションのリストはまだ収集していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 내 포지션의 리스트를 모으지 못했어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não coletamos listas para a sua posição."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для вашей позиции у нас пока нет списков."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们还没有收集到你的席位的曲目单。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們還沒有收集到任何符合你職位的清單。"
          }
        }
      }
    },
    "We list only auditions published on orchestras' own websites and checked by a person. Pull down to look again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir zeigen nur Probespiele, die auf den eigenen Websites der Orchester veröffentlicht und von einer Person geprüft wurden. Zieh nach unten, um neu zu suchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo mostramos audiciones publicadas en los sitios web de las propias orquestas y comprobadas por una persona. Desliza hacia abajo para volver a buscar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous ne répertorions que les auditions publiées sur les sites des orchestres eux-mêmes et vérifiées par une personne. Tirez vers le bas pour actualiser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elenchiamo solo audizioni pubblicate sui siti delle orchestre e controllate da una persona. Trascina verso il basso per cercare di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "掲載するのは、オーケストラの公式サイトで公表され、人が確認したオーディションだけです。下に引っ張ると再読み込みします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오케스트라 공식 웹사이트에 공개되고 사람이 확인한 오디션만 보여 드려요. 아래로 당기면 다시 찾아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listamos só audições publicadas nos sites das próprias orquestras e verificadas por uma pessoa. Puxe para baixo para buscar de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы показываем только прослушивания, опубликованные на сайтах самих оркестров и проверенные человеком. Потяните вниз, чтобы обновить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们只列出在乐团官网上公布并经人工核对的招考。下拉可重新查找。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們只列出樂團官方網站公布、並經人工核對的甄選。下拉可重新整理。"
          }
        }
      }
    },
    "We name a tier only once we have at least %lld lists. With fewer we show the plain count and say so." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Stufe nennen wir erst ab %lld Listen. Bei weniger zeigen wir nur die Anzahl und sagen das dazu."
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Solo asignamos un nivel cuando tenemos al menos %lld lista. Con menos, mostramos el recuento tal cual y lo indicamos."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Solo asignamos un nivel cuando tenemos al menos %lld listas. Con menos, mostramos el recuento tal cual y lo indicamos."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Nous n'attribuons un niveau qu'à partir de %lld liste. En dessous, nous montrons le simple décompte et le disons."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Nous n'attribuons un niveau qu'à partir de %lld listes. En dessous, nous montrons le simple décompte et le disons."
                }
              }
            }
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indichiamo una fascia solo quando abbiamo almeno %lld liste. Con meno mostriamo il semplice conteggio e lo diciamo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ランクを示すのは、リストが%lld件以上集まってからです。それ未満の場合は件数だけを表示し、その旨を示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "리스트가 %lld개 이상 모여야 등급을 매겨요. 그보다 적으면 개수만 보여 드리고 그렇다고 알려 드려요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só indicamos uma categoria quando temos pelo menos %lld listas. Com menos, mostramos a contagem simples e avisamos."
          }
        },
        "ru" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Мы называем категорию, только когда есть хотя бы %lld списка. Если списков меньше, мы показываем просто число и говорим об этом."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Мы называем категорию, только когда есть хотя бы %lld списков. Если списков меньше, мы показываем просто число и говорим об этом."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Мы называем категорию, только когда есть хотя бы %lld список. Если списков меньше, мы показываем просто число и говорим об этом."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Мы называем категорию, только когда есть хотя бы %lld списка. Если списков меньше, мы показываем просто число и говорим об этом."
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在至少有 %lld 份曲目单时我们才会评定等级。不足时只显示数量并加以说明。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "至少有 %lld 份清單時，我們才會判定等級。不足時只顯示單純的數量，並加以說明。"
          }
        }
      }
    },
    "Wear headphones so the microphone records only you, not the reference." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trag Kopfhörer, damit das Mikrofon nur dich aufnimmt, nicht die Referenz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa auriculares para que el micrófono te grabe solo a ti y no a la referencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portez un casque pour que le micro n'enregistre que vous, pas la référence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa le cuffie, così il microfono registra solo te e non il riferimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘッドフォンを着けると、マイクが参考音源を拾わず、自分の音だけを録音できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마이크에 레퍼런스가 아닌 내 소리만 녹음되도록 헤드폰을 쓰세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use fones de ouvido para que o microfone grave só você, não a referência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наденьте наушники, чтобы микрофон записывал только вас, а не образец."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请戴上耳机，这样麦克风只会录下你的演奏，而不会录到参考音频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請戴上耳機，讓麥克風只錄到你，而不是參考音訊。"
          }
        }
      }
