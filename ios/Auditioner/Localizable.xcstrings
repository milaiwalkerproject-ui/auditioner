    "Pick one from the open auditions below, or tap + to add your own with its list." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eines der offenen Probespiele unten, oder tippe auf +, um dein eigenes mit seiner Liste hinzuzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una de las audiciones abiertas de abajo o toca + para añadir la tuya con su lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez-en une parmi les auditions ouvertes ci-dessous, ou touchez + pour ajouter la vôtre avec sa liste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegline una tra le audizioni aperte qui sotto, oppure tocca + per aggiungere la tua con la sua lista."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下の募集中のオーディションから選ぶか、＋をタップして自分のオーディションをリストとともに追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래 오디션 공고에서 하나를 고르거나, +를 눌러 리스트와 함께 직접 추가하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma das audições abertas abaixo ou toque em + para adicionar a sua, com a lista."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите одно из открытых прослушиваний ниже или нажмите +, чтобы добавить своё вместе со списком."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从下方的公开招考中选择一个，或点按 + 添加你自己的试奏及其曲目单。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從下方開放中的甄選選一場，或點 + 加入你自己的甄選和清單。"
          }
        }
      }
    },
