    "Tap a suggestion to link the line to that excerpt. The percentage is how well the words agree." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf einen Vorschlag, um die Zeile mit dieser Stelle zu verknüpfen. Die Prozentzahl zeigt, wie gut die Wörter übereinstimmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una sugerencia para vincular la línea a ese extracto. El porcentaje indica cuánto coinciden las palabras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une suggestion pour lier la ligne à ce trait. Le pourcentage indique à quel point les mots concordent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un suggerimento per collegare la riga a quel passo. La percentuale indica quanto coincidono le parole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "候補をタップすると、その行をオケスタにリンクします。パーセントは文字列の一致度です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제안을 누르면 그 발췌곡에 줄이 연결돼요. 퍼센트는 단어가 얼마나 일치하는지를 뜻해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em uma sugestão para vincular a linha a esse excerto. A porcentagem indica o quanto as palavras coincidem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь подсказки, чтобы привязать строку к этому фрагменту. Процент показывает, насколько совпадают слова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按一个建议，将这一行与该片段关联。百分比表示文字的吻合程度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下建議項目，即可將這一行連結到該片段。百分比代表文字的相符程度。"
          }
        }
      }
    },
